@baseUrl = https://praxis-api-quickstart.onrender.com
@tenantId = demo
@userId = example-user
@envId = public

POST {{baseUrl}}/api/procurement/suppliers/option-sources/externalLookup/options/filter?search=External&page=0&size=10
Content-Type: application/json
Accept: application/json
X-Tenant-ID: {{tenantId}}
X-User-ID: {{userId}}
X-Env: {{envId}}

