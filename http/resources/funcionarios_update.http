### status: illustrative-only
### public: false
### authRequired: true
### sessionAuthRequired: true
### tenantScopedHeadersRequired: true
### destructive: true
### requiresTenantHeaders: true
### llmOperational: false
### protectedContract: false
### referenceOnly: true
### runtimeRecordConfirmed: false
### selectorConfirmed: true
### publishedBackendConfirmed: false
### knownPublishedFailure: false
### selectionGuidance: avoid-by-default-destructive-reference

@baseUrl = https://praxis-api-quickstart.onrender.com
@tenantId = demo
@userId = example-user
@envId = public
### First run funcionarios_get_by_id.http with the same session/scope/id.
### Copy its exact strong ETag (including quotes); edit that response snapshot.
### Include only fields declared by the update schema; do not copy ativo from the GET.
### Use deactivate/reactivate actions to change lifecycle state.
### Never refresh the token immediately before submitting an older payload.
@resourceEtag = REPLACE_WITH_STRONG_ETAG_FROM_GET
@csrfToken = REPLACE_WITH_SESSION_XSRF_TOKEN

PUT {{baseUrl}}/api/human-resources/funcionarios/1
Content-Type: application/json
If-Match: {{resourceEtag}}
X-XSRF-TOKEN: {{csrfToken}}
Accept: application/json
X-Tenant-ID: {{tenantId}}
X-User-ID: {{userId}}
X-Env: {{envId}}

< ../../payloads/resources/funcionarios_update.json
