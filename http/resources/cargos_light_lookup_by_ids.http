### note: LIGHT_LOOKUP by-ids rehydration preserves id order and returns lightweight labels.

@baseUrl = https://praxis-api-quickstart.onrender.com
@tenantId = demo
@userId = example-user
@envId = public

GET {{baseUrl}}/api/human-resources/cargos/option-sources/jobRole/options/by-ids?ids=1&ids=2&ids=3
Accept: application/json
X-Tenant-ID: {{tenantId}}
X-User-ID: {{userId}}
X-Env: {{envId}}
