### status: illustrative-only
### public: false
### authRequired: true
### sessionAuthRequired: true
### tenantScopedHeadersRequired: false
### destructive: true
### requiresTenantHeaders: false
### llmOperational: false
### protectedContract: true
### referenceOnly: false
### runtimeRecordConfirmed: false
### selectorConfirmed: true
### publishedBackendConfirmed: false
### knownPublishedFailure: false
### selectionGuidance: protected-contract-governed-pages-revision-save

@baseUrl = http://127.0.0.1:8088
@origin = http://127.0.0.1:4302
@draftId = 00000000-0000-4000-8000-000000000021
@pageId = 00000000-0000-4000-8000-000000000020
@draftEtag = "00000000-0000-4000-8000-000000000025"
@contextVersion = <contextVersion returned by GET /api/praxis/runtime/context>
@csrfToken = <raw CSRF token issued by the authenticated session>
@authorSession = <SESSION cookie issued to an authenticated page author>

# Compiles and persists an immutable revision of a praxis.dynamic-page.editor
# document containing praxis-dynamic-form and praxis-table widgets, presentation
# metadata, and menu navigation bindings, guarded by strong If-Match on the draft.

POST {{baseUrl}}/api/praxis/config/ui-layouts/drafts/{{draftId}}/revisions?rootComponentType=praxis-dynamic-page&rootComponentId={{pageId}}
Content-Type: application/json
Accept: application/json
Origin: {{origin}}
X-Praxis-Context-Version: {{contextVersion}}
If-Match: {{draftEtag}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: SESSION={{authorSession}}

< ../../payloads/config/pages_revision_save.json
