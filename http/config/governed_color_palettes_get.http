@baseUrl = https://praxis-api-quickstart.onrender.com
@tenantId = demo
@envId = public
@paletteKey = corporate-main

GET {{baseUrl}}/api/praxis/config/color-palettes/{{paletteKey}}
Accept: application/json
Origin: https://praxisui.dev
X-Tenant-ID: {{tenantId}}
X-Env: {{envId}}
# Reuse the returned ETag with If-None-Match to validate a 304 read.
