### status: illustrative-only
### public: false
### authRequired: true
### sessionAuthRequired: true
### tenantScopedHeadersRequired: false
### destructive: true
### requiresTenantHeaders: false
### llmOperational: false
### protectedContract: true
### referenceOnly: false
### runtimeRecordConfirmed: false
### selectorConfirmed: true
### publishedBackendConfirmed: false
### knownPublishedFailure: false
### selectionGuidance: protected-contract-governed-pages-head-rollback

@baseUrl = http://127.0.0.1:8088
@origin = http://127.0.0.1:4302
@pageId = 00000000-0000-4000-8000-000000000020
@headEtag = "00000000-0000-4000-8000-000000000028"
@contextVersion = <contextVersion returned by GET /api/praxis/runtime/context>
@csrfToken = <raw CSRF token issued by the authenticated session>
@publisherSession = <SESSION cookie issued to an authenticated page publisher>

# Rolls the active release head of a governed page back to a prior APPROVED
# release under strong If-Match. Revalidates current admission and active group
# references under deterministic locks without mutating other pages or groups.

POST {{baseUrl}}/api/praxis/config/ui-layouts/release-head/rollback?rootComponentType=praxis-dynamic-page&rootComponentId={{pageId}}
Content-Type: application/json
Accept: application/json
Origin: {{origin}}
X-Praxis-Context-Version: {{contextVersion}}
If-Match: {{headEtag}}
X-CSRF-TOKEN: {{csrfToken}}
Cookie: SESSION={{publisherSession}}

< ../../payloads/config/pages_head_rollback.json
